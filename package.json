{
  "name": "decklewright",
  "version": "0.1.0",
  "description": "Crop planning and derivative production for an oversize reformatting lab",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.15"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "deckle": "bin/deckle.js"
  },
  "files": [
    "src",
    "bin"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.19.0",
    "@vitest/coverage-v8": "3.0.5",
    "eslint": "9.19.0",
    "globals": "15.14.0",
    "prettier": "3.4.2",
    "vitest": "3.0.5"
  }
}
